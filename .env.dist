# portr8 — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.dist .env
#
# This file will be privatized with gprism and symlinked
# to your private vault. NEVER commit .env itself.

# Required: Google GenAI API key
GEMINI_API_KEY=your-api-key-here

# Optional: default image generation model
PORTR8_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Optional: default judge model (empirically proven best — see docs/SPECS.md Lesson #12)
PORTR8_JUDGE_MODEL=gemini-3.5-flash

# Optional: default target score (8.0 = CAPOLAVORO threshold, matching project name "portr-8")
PORTR8_TARGET_SCORE=8.0

# Optional: default max iterations
PORTR8_MAX_ITERATIONS=20

# Optional: reference transport method (files_api > pil > gcs — see docs/SPECS.md Lesson #1)
PORTR8_REF_TRANSPORT=files_api

# Optional: base directory for character reference photos
# Default: data/characters/ (which should be a symlink to your private vault)
PORTR8_REF_DIR=data/characters
